# ─────────────────────────────────────────────────────────────────────────────
# Immerse the Bay 2026 — application portal
#
# Local setup:  cp .env.example .env.local  &&  fill in the blanks
# On Vercel:    `vercel env pull .env.local` once Neon is installed
# ─────────────────────────────────────────────────────────────────────────────

# ── Database ────────────────────────────────────────────────────────────────
# Provision with:  vercel install neon
# Neon gives you TWO connection strings and the difference matters:
#   DATABASE_URL        pooled   — hostname contains `-pooler`. Used at runtime.
#                                  Handles ~10k clients; Vercel opens one
#                                  connection per function invocation.
#   DATABASE_URL_DIRECT direct   — no `-pooler`. Used ONLY by drizzle-kit;
#                                  transaction-mode pooling breaks migrations.
# lib/db/index.ts refuses to boot in production if DATABASE_URL isn't pooled.
DATABASE_URL="postgresql://user:pass@ep-xxx-pooler.us-west-2.aws.neon.tech/neondb?sslmode=require"
DATABASE_URL_DIRECT="postgresql://user:pass@ep-xxx.us-west-2.aws.neon.tech/neondb?sslmode=require"

# ── Auth ────────────────────────────────────────────────────────────────────
# Generate with:  openssl rand -base64 32
BETTER_AUTH_SECRET=""
# No trailing slash. Vercel previews are handled automatically by the SDK.
BETTER_AUTH_URL="http://localhost:3000"

# Google Cloud Console → APIs & Services → Credentials → OAuth client ID (Web)
#
# CRITICAL: the OAuth *consent screen* must be published to "In production".
# While it sits in "Testing" you are hard-capped at 100 users and everyone sees
# an unverified-app warning. Publishing is a toggle, not a review — the scopes
# we request (openid, email, profile) are non-sensitive and need no verification.
#
# Authorized redirect URIs must include every origin you sign in from:
#   http://localhost:3000/api/auth/callback/google
#   https://apply.immersethebay.org/api/auth/callback/google
#   https://<preview-deployment>.vercel.app/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# GitHub → Settings → Developer settings → OAuth Apps
# GitHub allows only ONE callback URL per app, so create two apps — one for
# production, one for local/preview — and swap the pair per environment.
#   Callback: http://localhost:3000/api/auth/callback/github
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# ── Email (Resend) ──────────────────────────────────────────────────────────
# A verified sending domain is REQUIRED to email arbitrary recipients.
# Free tier is 100/day (3,000/mo) — fine for confirmations, nowhere near enough
# for a decision send. Upgrade to Pro ($20) for the decision month only.
# Send from a subdomain to insulate the root domain's reputation, and add SPF,
# DKIM and DMARC (p=none) before the first send.
RESEND_API_KEY=""
EMAIL_FROM="Immerse the Bay <apply@send.immersethebay.org>"
EMAIL_REPLY_TO=""

# ── Uploads (Vercel Blob) ───────────────────────────────────────────────────
# Created automatically by `vercel blob store add`.
BLOB_READ_WRITE_TOKEN=""

# ── Analytics (PostHog) ─────────────────────────────────────────────────────
# Free tier: 1M events + 5k session replays per month. Set a billing cap.
# Before recording real applicants: verify input masking on the actual form and
# turn on IP anonymization — this form collects PII.
NEXT_PUBLIC_POSTHOG_KEY=""
NEXT_PUBLIC_POSTHOG_HOST="https://us.i.posthog.com"

# ── Event configuration ─────────────────────────────────────────────────────
# Age is evaluated as of the event's first day, not as of submission: someone
# who turns 18 in October is eligible for a November event.
NEXT_PUBLIC_EVENT_START="2026-11-13"
NEXT_PUBLIC_APPLICATIONS_CLOSE="2026-10-02T23:59:59-07:00"
